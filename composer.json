{
    "name": "seiger/smailer",
    "license": "GPL-3.0",
    "type": "evolution-cms-module",
    "description": "Visual email campaign builder, subscriber management, and scheduled delivery for Evolution CMS.",
    "keywords": [
        "evocms",
        "evolution-cms",
        "email",
        "email-marketing",
        "newsletter",
        "mailing-list",
        "campaign-builder",
        "subscriber-management"
    ],
    "authors": [
        {
            "name": "Serhii Korneliuk",
            "email": "info@seigerit.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "evolution-cms/evolution": "^3.5.7",
        "evolution-cms/evo-ui": "*",
        "seiger/stask": "*"
    },
    "autoload": {
        "psr-4": {
            "Seiger\\sMailer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seiger\\sMailer\\sMailerServiceProvider"
            ],
            "aliases": {
                "sMailer": "Seiger\\sMailer\\Facades\\sMailer"
            }
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    }
}
